OPENAI_API_KEY=
SORA_MOCK_MODE=false
NEXT_PUBLIC_APP_NAME=Hyperce Editor

# Editor signin
AUTH_USERNAME=admin@example.com
AUTH_PASSWORD=change-this-password
AUTH_JWT_SECRET=change-this-long-random-secret

# Azure AI Foundry / Azure OpenAI Sora
# Azure AI Foundry resource endpoint. The app calls:
# https://your-resource.services.ai.azure.com/openai/v1/videos?api-version=preview
SORA_API_PROVIDER=azure
AZURE_AI_FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com
AZURE_API_KEY=
AZURE_AI_FOUNDRY_MODEL=sora-2

# Legacy Azure OpenAI v1 job endpoint support:
# SORA_AZURE_API_KIND=azure-openai-v1
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT_NAME=sora
AZURE_OPENAI_API_VERSION=preview
